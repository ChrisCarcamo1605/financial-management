# Base de datos. Local con Docker (docker compose up -d db):
DATABASE_URL=postgresql://caudal:caudal@localhost:5433/caudal
# o Supabase / cualquier Postgres:
# DATABASE_URL=postgresql://user:password@host:5432/postgres

# Firma de los JWT (genera uno largo y aleatorio en producción)
JWT_SECRET_KEY=change-me

# Orígenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000

# Producción con frontend en otro dominio:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=None

# FLASK_DEBUG=1
